opam-version: "2.0"
synopsis: "Account-synced browser text-input workflows, built with OxCaml"
maintainer: "Linput contributors"
authors: "Linput contributors"
build: [["dune" "build" "src/background.bc.js" "src/content.bc.js" "src/options.bc.js" "-j" jobs]]
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.17"}
  "js_of_ocaml" {>= "6.0"}
]
